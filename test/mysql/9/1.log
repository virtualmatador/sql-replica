ALTER TABLE `demo`.`article` RENAME COLUMN `_sql_id` to `id`, RENAME COLUMN `_sql_title` to `title`;
SET @r = 'No extra foreign keys in "article".';
ALTER TABLE `demo`.`article` MODIFY `id` int unsigned not null auto_increment COMMENT 'ARTICLE_ID' FIRST, MODIFY `title` varchar(64) CHARACTER SET latin1 not null COMMENT 'ARTICLE_TITLE' AFTER `id`, ADD primary key (`id`), DROP COLUMN `_sql__drop__sql_`;
